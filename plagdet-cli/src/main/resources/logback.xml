<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>  <!-- Log file location -->

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/app-%d{yyyy-MM-dd}.log</fileNamePattern>  <!-- Daily rotation -->
            <maxHistory>7</maxHistory>  <!-- Keep logs for 7 days -->
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="edu.stanford.nlp.process.PTBLexer" level="ERROR" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>

    <!--Turn off logging of URI exception when openxml relationships are parsed-->
    <logger name="org.apache.poi.openxml4j.opc.PackageRelationshipCollection" level="OFF">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.apache.poi" level="OFF">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="com.itextpdf.kernel.pdf.PdfReader" level="OFF">
        <appender-ref ref="STDOUT"/>
    </logger>


    <logger name="dev.taras.hamkalo.plagdet.Plagdet"
            level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="dev.taras.hamkalo.plagdet.comparision.Embeddings"
            level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="dev.taras.hamkalo.plagdet.indexing.lucene.LuceneFileDataSource"
            level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="dev.taras.hamkalo.plagdet.io.filedata.EagerFileDataSource"
            level="trace" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="dev.taras.hamkalo.plagdet.io.filedata.LazyFileDataSource"
            level="trace" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="dev.taras.hamkalo.plagdet.io.filedata.LazyFileDataSource"
            level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

</configuration>